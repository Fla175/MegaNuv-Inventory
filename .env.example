# MegaNuv Inventory — Variáveis de Ambiente (.env.example)
# Copie para .env e preencha os valores reais. O .env NUNCA é rastreado pelo Git (.gitignore usa .env*).

# --- Banco de dados (MariaDB com system-versioning) ---
# DATABASE_URL=mysql://USUÁRIO:SENHA@HOST:PORTA/banco

# --- Autenticação (obrigatório — ausente, o app crasha em lib/auth.ts:8) ---
JWT_SECRET=SEU_SECRET_JWT_AQUI

# --- MinIO (S3) ---
# Cliente interno (API MinIO)
MINIO_ENDPOINT=HOST_DO_MINIO
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=USUÁRIO_MINIO
MINIO_SECRET_KEY=SENHA_MINIO

# Cliente público (para presigned URLs)
# Preencha com o host público real do seu MinIO. NÃO versione o valor de produção.
MINIO_PUBLIC_ENDPOINT=SEU_HOST_PUBLICO_MINIO
MINIO_PUBLIC_PORT=80
MINIO_PUBLIC_USE_SSL=false

# --- Acesso do Criador ---
# Não há flag: o recurso é sempre ativo e sempre exige a senha do criador.

# --- Sessão ---
# COOKIE_SECURE=true   # ativar em produção (HTTPS)
# NEXT_PUBLIC_BASE_URL=https://<host-publico-da-aplicacao>
