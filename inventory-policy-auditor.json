{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBucketForAudit",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::inventory"]
    },
    {
      "Sid": "DeleteObjectForAudit",
      "Effect": "Allow",
      "Action": ["s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::inventory/*"]
    }
  ]
}
